{
	"$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
	"grammars": [
		{
			"name": "svelte",
			"camelcase": "Svelte",
			"title": "Svelte",
			"scope": "source.svelte",
			"file-types": ["svelte"],
			"injection-regex": "^svelte$",
			"class-name": "TreeSitterSvelte",
			"highlights": "queries/highlights.scm",
			"injections": "queries/injections.scm"
		}
	],
	"metadata": {
		"version": "2.0.0",
		"license": "MIT",
		"description": "Svelte grammar for tree-sitter",
		"links": {
			"repository": "https://github.com/sveltejs/tree-sitter-svelte/",
			"funding": "https://opencollective.com/svelte"
		}
	},
	"bindings": {
		"c": false,
		"go": false,
		"java": false,
		"node": false,
		"python": false,
		"rust": false,
		"swift": false,
		"zig": false
	}
}
